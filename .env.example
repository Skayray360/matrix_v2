# Creado por Aldo Garcia.
# ---------------------------------------------------------------------------
# Plantilla de configuracion de Matrix RH.
# Copiar a .env y ajustar. NUNCA versionar el .env real.
# Todos los valores marcados replace_me son ficticios.
# ---------------------------------------------------------------------------

# --- Aplicacion ---------------------------------------------------------
APP_ENV=development
APP_NAME=Matrix RH
APP_BASE_URL=http://127.0.0.1:8000
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
# Clave usada para firmar el UserContext dentro del request y las cookies de
# sesion. En development se autogenera; en production es OBLIGATORIA.
APP_SECRET_KEY=replace_me_with_64_random_hex_chars

# --- Ollama (local, nunca expuesto a Internet) --------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=gemma4:latest
OLLAMA_DEEP_MODEL=qwen3.6:latest
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_EMBEDDING_DIMENSION=768
# Confirme variante, digest, cuantizacion y memoria con model_inventory.
# El tamano real no se deduce de una etiqueta :latest.
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_KEEP_ALIVE=15m
# Presupuesto rapido (Gemma) y profundo (Qwen). Ajustar a la RAM/VRAM disponible
# sin cambiar la politica de routing ni eliminar los limites de salida.
OLLAMA_FAST_NUM_CTX=8192
OLLAMA_DEEP_NUM_CTX=32768
OLLAMA_FAST_MAX_TOKENS=768
OLLAMA_DEEP_MAX_TOKENS=2048
# Cache LRU local de embeddings de consulta (clave SHA-256; no guarda el texto).
OLLAMA_EMBEDDING_CACHE_SIZE=256
# Compatibilidad con 1.1.0: los lotes ahora son secuenciales y usan el cupo global.
OLLAMA_SUMMARY_PARALLEL_BATCHES=2

# --- Adapters de inferencia (todos los selectores en este archivo) ---------
# ollama | openai_compatible | vertex. Vertex requiere opt-in cloud explicito.
LLM_PROVIDER=ollama
LLM_DEEP_PROVIDER=ollama
LLM_EMBEDDING_PROVIDER=ollama
LLM_LOCAL_ONLY=true
# Incluya solo hosts internos aprobados. El cliente local no usa proxies del SO.
LLM_LOCAL_HOSTS=127.0.0.1,localhost,::1
LLM_API_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
# https://REGION-aiplatform.googleapis.com/v1/projects/PROYECTO/locations/REGION/publishers/google/models
LLM_VERTEX_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_GENERAL_TEMPERATURE=0.25
LLM_SUMMARY_TEMPERATURE=0.08
LLM_RETRY_TEMPERATURE=0.03
LLM_TOP_P=0.9
# default conserva el comportamiento del runtime; enabled/disabled son opt-in.
# Ollama recibe think; API compatible recibe chat_template_kwargs.enable_thinking.
# Ver docs/LOCAL_MODEL_READINESS.md antes de activar en otro runtime/modelo.
LLM_FAST_THINKING=default
LLM_DEEP_THINKING=default
LLM_STRUCTURED_THINKING=default
# Opcionales: descomentar solo si el runtime soporta top_k. No ponen limites de VRAM.
# LLM_FAST_TOP_K=64
# LLM_DEEP_TOP_K=64
# La fachada ModelClient hace un solo intento HTTP. Este valor solo corresponde
# al adapter OllamaClient directo conservado para compatibilidad.
LLM_MAX_TRANSIENT_RETRIES=0
LLM_REQUEST_DEADLINE_SECONDS=120
LLM_PLANNER_MAX_TOKENS=600
LLM_PLANNER_TEMPERATURE=0.0
# Parametro legado; la memoria resumida ahora es extractiva sin inferencia.
LLM_MEMORY_MAX_TOKENS=200
# Ollama obtiene revision/digest de /api/tags; otros runtimes requieren revision
# inmutable administrada por TI (hash de pesos + tokenizer + plantilla efectiva).
LLM_EMBEDDING_REVISION=unverified
LLM_FAST_DIGEST=
LLM_DEEP_DIGEST=
LLM_EMBEDDING_DIGEST=
LLM_QUERY_TEMPLATE="task: search result | query: {text}"
LLM_DOCUMENT_TEMPLATE="title: {title} | text: {text}"
LLM_SYSTEM_PREFIX=

# --- Admision y aislamiento (un proceso API) ------------------------------
CHAT_MAX_INFLIGHT=4
INFERENCE_MAX_INFLIGHT=2
UPLOAD_MAX_INFLIGHT=1
UPLOAD_MAX_TOTAL_BYTES=134217728
UPLOAD_MAX_DOCUMENTS_PER_USER=50
UPLOAD_BODY_MAX_BYTES=30000000
EXTRACTION_TIMEOUT_SECONDS=30
EXTRACTION_MEMORY_MB=512
EXTRACTION_MAX_CHARS=2000000

# --- RAG ----------------------------------------------------------------
RAG_VECTOR_STORE=qdrant
RAG_CHUNK_SIZE_TOKENS=900
RAG_CHUNK_OVERLAP_TOKENS=120
RAG_EMBEDDING_DIMENSION=768
RAG_TOP_K=6
RAG_FETCH_K=24
RAG_MIN_SIMILARITY=0.35
RAG_MMR_LAMBDA=0.65
RAG_SEARCH_STRATEGY=cosine_hnsw_metadata_filter_mmr
RAG_REINDEX_INTERVAL_HOURS=24
RAG_KNOWLEDGE_ROOT=./data/knowledge
RAG_COLLECTION_CORPORATE=matrix_rh_corporate
RAG_COLLECTION_PRIVATE=matrix_rh_private
# El resumen de adjuntos hace scroll ACL por metadata hasta este limite. Cuando
# lo alcanza, Matrix RH lo informa; nunca trunca de forma silenciosa.
RAG_SUMMARY_SCAN_MAX_CHUNKS=256
RAG_SUMMARY_MAX_CHUNKS=24

# --- Autenticacion ------------------------------------------------------
# local_test | entra | oidc (IdP interno, por ejemplo Keycloak + AD LDAPS)
AUTH_PROVIDER=local_test
LOCAL_TEST_AUTH_ENABLED=true
LOCAL_TEST_SEED_USERS_ENABLED=true
LOCAL_TEST_SEED_PROFILE=matrix_demo
SESSION_COOKIE_NAME=matrixrh_session
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- Microsoft Entra ID (PREPARED_NOT_CONNECTED por defecto) -------------
ENTRA_TENANT_ID=replace_me
ENTRA_CLIENT_ID=replace_me
ENTRA_CLIENT_SECRET=replace_me
ENTRA_REDIRECT_URI=https://localhost/api/v1/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=https://localhost/
ENTRA_ALLOWED_GROUPS=
ENTRA_ROLE_MAPPING_FILE=./config/authorization/entra-role-mapping.yaml

# --- OIDC interno: inactivo mientras AUTH_PROVIDER no sea oidc -----------
# Copiar valores EXACTOS del discovery del realm de TI, sin desactivar TLS.
OIDC_ISSUER=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_GROUPS=
# El mapeo conserva ENTRA_ROLE_MAPPING_FILE; entradas internas: provider: oidc.

# --- Base de datos interna ----------------------------------------------
# WAMP por defecto expone MySQL en 127.0.0.1:3306 con usuario root sin password.
# Para produccion usar un usuario dedicado con permisos minimos.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/matrix_rh?charset=utf8mb4
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# --- Fuentes estructuradas ----------------------------------------------
STRUCTURED_SOURCES_CONFIG=./config/data_sources/sources.yaml
STRUCTURED_QUERY_TIMEOUT_SECONDS=15
STRUCTURED_MAX_ROWS=200

# --- Qdrant --------------------------------------------------------------
# embedded = almacenamiento local persistente gestionado por qdrant-client.
# server   = instancia Qdrant dedicada accesible por HTTP.
QDRANT_MODE=embedded
QDRANT_PATH=./var/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# --- Politicas de autorizacion ------------------------------------------
AUTHORIZATION_POLICY_FILE=./config/authorization/categories.yaml

# --- Cargas de archivos --------------------------------------------------
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_FILES_PER_REQUEST=5
UPLOAD_STORAGE_ROOT=./var/uploads
UPLOAD_ALLOWED_EXTENSIONS=.docx,.md,.pdf,.txt,.xlsx,.csv

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=30

# --- Scheduler -----------------------------------------------------------
SCHEDULER_ENABLED=true

# --- Instalacion Windows -------------------------------------------------
MATRIX_INSTALL_MODE=windows_local
MATRIX_USE_WAMP_MYSQL=true
MATRIX_EXTERNAL_CONNECTORS_REQUIRED=false
MATRIX_INSTALL_ROOT=

# Permite usar una base de datos que YA EXISTIA antes de instalar Matrix RH.
# Por defecto false: una base preexistente puede pertenecer a otra aplicacion
# aunque en este momento este vacia (por ejemplo, tras el downgrade de otro
# proyecto), y apropiarse de ella pondria a dos aplicaciones a migrar sobre el
# mismo sitio. Pongalo en true solo si esa base es suya y la quiere reutilizar.
MATRIX_ADOPT_EXISTING_DATABASE=false
